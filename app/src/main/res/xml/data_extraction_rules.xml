<?xml version="1.0" encoding="utf-8"?>
<!-- Models the user adds can be hundreds of MB and are easy to re-add, so keep them out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
